# ============================================================
# EduQuery AI - Backend Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------
PORT=5000
NODE_ENV=development


# ------------------------------------------------------------
# CORS Configuration
# Comma-separated list of allowed frontend origins
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173


# ------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------

# Supabase Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only secret/service role key
# NEVER expose this key in frontend code or VITE_ variables
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_secret_key

# Public/anonymous key used for token verification
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key


# ------------------------------------------------------------
# Google Gemini AI Configuration
# ------------------------------------------------------------

# Google Gemini API Key
# Keep this server-side only
GEMINI_API_KEY=your_google_gemini_api_key

# Embedding model used for document vector generation
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Generation model used for grounded RAG answers
GEMINI_GENERATION_MODEL=gemini-3.6-flash